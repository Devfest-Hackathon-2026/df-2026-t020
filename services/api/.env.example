# localhost で動かすときに、このファイルを .env にコピーして書き換える（.env はコミットしない）。
# Gemini の設定がなければ、理由の1文は決まった文で返す。

# 画面（pnpm dev）のオリジン。画面から API を呼べるようにする（CORS）
ALLOWED_ORIGINS=http://localhost:3000

# Vertex AI で Gemini を呼ぶ（認証は `gcloud auth application-default login`）
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# モデルを変えるとき（省略時は gemini-4-argon。前の名前 GEMINI_FLASH_MODEL も読む）
# GEMINI_MODEL=gemini-4-argon
# 1,000職業から選ぶとき（/api/recommend）だけ別のモデルにするとき（省略時は GEMINI_MODEL と同じ）
# GEMINI_RECOMMEND_MODEL=

# 設定があっても Gemini を使わないとき
# REASON_LLM=off
